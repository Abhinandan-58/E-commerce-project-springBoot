pipeline {
    agent any

    stages {
        stage('Pull Code') {
            steps {
                git branch: 'master2', url: 'https://github.com/Abhinandan-58/E-commerce-project-springBoot.git'
            }
        }

        stage('Build') {
            steps {
                dir('E-commerce-application') { 
                    sh 'mvn clean package'
                }
            }
        }
    }
}