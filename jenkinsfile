pipeline {
    agent any

    environment {
        EC2_USER = "ubuntu"    // Ubuntu server user
        EC2_HOST = "35.164.156.107"  // Terraform output
        SSH_KEY  = "/var/lib/jenkins/abhi.pem"
    }

    stages {

        stage('Pull Code from GitHub') {
            steps {
                git branch: 'master2', url: 'https://github.com/Abhinandan-58/E-commerce-project-springBoot.git'
            }
        }

        stage('Build Spring Boot App') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Upload JAR to Ubuntu EC2') {
            steps {
                sh '''
                scp -o StrictHostKeyChecking=no \
                -i ${SSH_KEY} \
                target/*.jar ${EC2_USER}@${EC2_HOST}:/home/ubuntu/app/app.jar
                '''
            }
        }

        stage('Restart Spring Boot Service') {
            steps {
                sh '''
                ssh -o StrictHostKeyChecking=no \
                -i ${SSH_KEY} ${EC2_USER}@${EC2_HOST} \
                "sudo systemctl restart springboot"
                '''
            }
        }
    }
}
