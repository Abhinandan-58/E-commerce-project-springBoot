pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'master2', url: 'https://github.com/Abhinandan-58/E-commerce-project-springBoot.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

    }
}